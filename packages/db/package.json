{
  "name": "@tms/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "migrate:up": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "codegen": "kysely-codegen --out-file src/types.ts --dialect postgres --url postgres://postgres:postgres@localhost:5432/tms",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "kysely": "0.28.17",
    "pg": "8.23.1",
    "@tms/config": "workspace:*",
    "@tms/logger": "workspace:*"
  },
  "devDependencies": {
    "@tms/bun-test-config": "workspace:*",
    "@tms/tsconfig": "workspace:*",
    "@types/pg": "8.23.1",
    "bun-types": "^1.4.2",
    "kysely-codegen": "0.19.0",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
