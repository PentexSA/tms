{
  "name": "@tms/sheet-core",
  "version": "0.0.0",
  "private": true,
  "description": "Núcleo do motor de ficha: contrato de template, listas fechadas e validadores. TS puro, roda no Bun (API) e no Expo (app).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@tms/tsconfig": "workspace:*",
    "bun-types": "^1.4.2",
    "fast-check": "^4.10.2",
    "typescript": "catalog:"
  }
}
