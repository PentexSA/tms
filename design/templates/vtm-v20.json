    "concept": {
      "type": "text",
      "label": "Conceito",
      "maxLength": 80,
      "help": "Uma frase sobre quem o personagem era antes da história: profissão, papel ou jeito de viver."
    },
    "clan": {
      "type": "choice",
      "label": "Clã",
      "options": [
        {
          "id": "assamitas",
          "label": "Assamitas",
          "help": "Clã de assassinos e estudiosos, com uma tradição de disciplina e de honra própria."
        },
        {
          "id": "brujah",
          "label": "Brujah",
          "help": "Clã de rebeldes e idealistas, de temperamento quente e rápido para a briga."
        },
        {
          "id": "gangrel",
          "label": "Gangrel",
          "help": "Clã de andarilhos próximos dos animais, que vivem longe das cidades com facilidade."
        },
        {
          "id": "giovanni",
          "label": "Giovanni",
          "help": "Clã de família e de negócios, ligado aos mortos e fechado aos de fora."
        },
        {
          "id": "lasombra",
          "label": "Lasombra",
          "help": "Clã de líderes ambiciosos, ligados às sombras. A maioria está no Sabá."
        },
        {
          "id": "malkavianos",
          "label": "Malkavianos",
          "help": "Clã marcado por algum tipo de loucura, que às vezes vê o que os outros não veem."
        },
        {
          "id": "nosferatu",
          "label": "Nosferatu",
          "help": "Clã de aparência monstruosa, que vive escondido e negocia segredos."
        },
        {
          "id": "ravnos",
          "label": "Ravnos",
          "help": "Clã de viajantes e trapaceiros, mestres da ilusão."
        },
        {
          "id": "seguidores-de-set",
          "label": "Seguidores de Set",
          "help": "Clã de cultistas de um deus antigo, que corrompem pela tentação."
        },
        {
          "id": "toreador",
          "label": "Toreador",
          "help": "Clã de artistas e amantes da beleza, influentes na alta sociedade."
        },
        {
          "id": "tremere",
          "label": "Tremere",
          "help": "Clã de feiticeiros do sangue, organizado numa hierarquia rígida."
        },
        {
          "id": "tzimisce",
          "label": "Tzimisce",
          "help": "Clã de senhores antigos que moldam carne e osso. A maioria está no Sabá."
        },
        {
          "id": "ventrue",
          "label": "Ventrue",
          "help": "Clã de aristocratas e líderes, exigentes até com a presa."
        },
        {
          "id": "caitiff",
          "label": "Caitiff",
          "help": "Vampiro sem clã conhecido. Não tem Disciplinas de clã nem fraqueza de clã."
        }
      ],
      "help": "A linhagem do vampiro. Define três Disciplinas mais fáceis de aprender e uma fraqueza própria."
    },
