    "name": { "type": "text", "label": "Nome", "maxLength": 80 },
    "deedName": {
      "type": "text",
      "label": "Nome de feito",
      "maxLength": 80,
      "help": "O nome que o personagem ganhou por um feito marcante, dado pela seita ou pela matilha (ex.: Canta-Tempestade). Pode ficar vazio no começo."
    },
    "concept": {
      "type": "text",
      "label": "Conceito",
      "maxLength": 80,
      "help": "Uma frase sobre quem o personagem era antes da história: profissão, papel ou jeito de viver."
    },
    "breed": {
      "type": "choice",
      "label": "Raça",
      "options": [
        {
          "id": "hominideo",
          "label": "Hominídeo",
          "help": "Nasceu humano e cresceu entre pessoas. Entende a cidade melhor que o mato."
        },
        {
          "id": "impuro",
          "label": "Impuro",
          "help": "Filho de dois pais da mesma espécie. Carrega uma deformidade desde o nascimento."
        },
        {
          "id": "lupino",
          "label": "Lupino",
          "help": "Nasceu lobo e aprendeu a forma humana depois. Entende o mato melhor que a cidade."
        }
      ],
      "help": "A forma em que o personagem nasceu: humana, lobo ou mestiça. Muda a Gnose inicial e os Dons à mão."
    },
    "auspice": {
      "type": "choice",
      "label": "Augúrio",
      "glyph": "augur-moon",
      "options": [
        {
          "id": "ragabash",
          "label": "Ragabash",
          "meta": "lua nova",
          "glyphParam": 0,
          "help": "Nasceu na lua nova: o questionador e trapaceiro, que testa as regras do grupo."
        },
        {
          "id": "theurge",
          "label": "Theurge",
          "meta": "lua crescente",
          "glyphParam": 0.25,
          "help": "Nasceu na lua crescente: o místico, que lida com os espíritos."
        },
        {
          "id": "philodox",
          "label": "Philodox",
          "meta": "meia-lua",
          "glyphParam": 0.5,
          "help": "Nasceu na meia-lua: o juiz, que busca o equilíbrio e guarda a tradição."
        },
        {
          "id": "galliard",
          "label": "Galliard",
          "meta": "lua gibosa",
          "glyphParam": 0.75,
          "help": "Nasceu na lua gibosa: o contador de histórias, que guarda a memória do grupo."
        },
        {
          "id": "ahroun",
          "label": "Ahroun",
          "meta": "lua cheia",
          "glyphParam": 1,
          "help": "Nasceu na lua cheia: o guerreiro, que vai à frente na luta."
        }
      ],
      "help": "A fase da lua no nascimento, que define o papel no grupo. Muda a Fúria inicial e os Dons à mão."
    },
    "tribe": {
      "type": "choice",
      "label": "Tribo",
      "options": [
        {
          "id": "furias-negras",
          "label": "Fúrias Negras",
          "help": "Tribo quase só de mulheres, protetoras dos lugares selvagens."
        },
        {
          "id": "roedores-de-ossos",
          "label": "Roedores de Ossos",
          "help": "Tribo dos que vivem à margem, entre os pobres e esquecidos das cidades."
        },
        {
          "id": "filhos-de-gaia",
          "label": "Filhos de Gaia",
          "help": "Tribo de curandeiros e pacificadores, que busca a união entre as tribos."
        },
        {
          "id": "fianna",
          "label": "Fianna",
          "help": "Tribo de bardos e guerreiros de origem celta, amantes de festas e histórias."
        },
        {
          "id": "crias-de-fenris",
          "label": "Crias de Fenris",
          "help": "Tribo de guerreiros de origem nórdica, que valoriza a força e a batalha."
        },
        {
          "id": "andarilhos-do-asfalto",
          "label": "Andarilhos do Asfalto",
          "help": "Tribo adaptada à cidade e à tecnologia."
        },
        {
          "id": "garras-vermelhas",
          "label": "Garras Vermelhas",
          "help": "Tribo de lupinos que rejeita a humanidade e defende a natureza."
        },
        {
          "id": "senhores-das-sombras",
          "label": "Senhores das Sombras",
          "help": "Tribo ambiciosa e disciplinada, que busca o poder e a liderança."
        },
        {
          "id": "peregrinos-silenciosos",
          "label": "Peregrinos Silenciosos",
          "help": "Tribo de viajantes e mensageiros, sem um lar fixo."
        },
        {
          "id": "presas-de-prata",
          "label": "Presas de Prata",
          "help": "Tribo nobre, de linhagens antigas, que por tradição lidera as outras."
        },
        {
          "id": "observadores-das-estrelas",
          "label": "Observadores das Estrelas",
          "help": "Tribo de místicos e filósofos, voltada à meditação e ao equilíbrio."
        },
        {
          "id": "uktena",
          "label": "Uktena",
          "help": "Tribo de místicos, ligada a segredos e a espíritos antigos."
        },
        {
          "id": "wendigo",
          "label": "Wendigo",
          "help": "Tribo de guerreiros ligada aos povos originários da América do Norte."
        }
      ],
      "help": "A sociedade a que o personagem pertence. Muda a Força de Vontade inicial e os Dons à mão."
    },
    "rank": {
      "type": "rating",
      "label": "Posto",
      "min": 0,
      "max": 5,
      "valueLabels": {
        "0": "Filhote",
        "1": "Cliath",
        "2": "Fostern",
        "3": "Adren",
        "4": "Athro",
        "5": "Ancião"
      },
      "help": "A posição na sociedade. Começa em 1 e sobe com o Renome. Dom acima do Posto pede a confirmação do narrador."
    },
    "sept": {
      "type": "text",
      "label": "Seita",
      "maxLength": 80,
      "help": "A comunidade de lobisomens que guarda um caern, um lugar sagrado onde o mundo espiritual fica perto. Tem cargos próprios, do Guardião ao Mestre do Rito, e é a casa do personagem entre os Garou."
