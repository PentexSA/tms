      "item": { "notes": true },
      "help": "Efeitos que o mago já domina. Anote as Esferas e o que a rotina faz nas notas de cada uma."
    },

    "willpower": {
      "type": "resource",
      "label": "Força de Vontade",
      "shortLabel": "FdV",
      "permanent": { "min": 1, "max": 10, "default": 5 },
      "editableIn": ["play"],
      "defaultAction": "spend1",
      "help": "Permanente limita o temporário. O permanente só muda em Evoluir."
    },
    "wheel": {
      "type": "clock",
      "label": "Quintessência e Paradoxo",
      "shortLabel": "Roda",
      "segments": 20,
      "rule": "mage-quint-paradox",
      "editableIn": ["play"],
      "fills": [
        {
          "id": "quintessence",
          "label": "Quintessência",
          "colorRole": "accent",
          "from": "start",
          "default": {
            "derive": "sum",
            "from": [{ "list": "backgrounds", "item": "Avatar" }]
          }
        },
        {
          "id": "paradox",
          "label": "Paradoxo",
          "colorRole": "alt-cool",
          "from": "end"
        }
      ],
      "help": "Quintessência e Paradoxo dividem as 20 casas da roda. Ganhar Paradoxo com a roda cheia consome 1 Quintessência. A Quintessência começa igual ao Avatar."
    },
    "health": {
      "type": "track",
      "label": "Vitalidade",
      "shortLabel": "Vitalidade",
      "rule": "wod-stacking",
      "editableIn": ["play"],
      "levels": [
        { "label": "Escoriado", "penalty": 0 },
        { "label": "Machucado", "penalty": -1 },
        { "label": "Ferido", "penalty": -1 },
        { "label": "Ferido gravemente", "penalty": -2 },
        { "label": "Espancado", "penalty": -2 },
        { "label": "Aleijado", "penalty": -5 },
        { "label": "Incapacitado", "penalty": null }
      ],
      "types": [
        { "id": "aggravated", "label": "Agravado", "glyph": "✱" },
        { "id": "lethal", "label": "Letal", "glyph": "X" },
        { "id": "bashing", "label": "Contusivo", "glyph": "/" }
      ]
    },

