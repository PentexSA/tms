  "templateVersion": "1.8.0",
  "locale": "pt-BR",
  "skin": "wod",
  "license": "O template traz nomes de traços, regras numéricas e frases curtas do time (ajuda e Esferas), escritas com palavras próprias. Nenhum texto do livro é embutido.",
  "identity": {
    "emblem": "nine-star",
    "name": "name",
    "chip": "tradition",
    "summary": ["concept", "essence"],
    "voice": "quote",
    "columns": [
      ["name"],
      ["nature", "demeanor", "concept"],
      ["tradition", "essence", "house"]
    ]
  },
  "accent": {
    "from": "tradition",
    "map": {
      "ordem-de-hermes": "accent-8",
      "coro-celestial": "accent-16",
      "culto-do-extase": "accent-10",
      "eutanatos": "accent-12",
      "irmandade-akashica": "accent-2",
      "sonhadores": "accent-15",
      "verbena": "accent-4",
      "filhos-do-eter": "accent-6",
