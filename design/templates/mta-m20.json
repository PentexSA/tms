      "type": "text",
      "label": "Conceito",
      "maxLength": 80,
      "help": "Uma frase sobre quem o personagem era antes da história: profissão, papel ou jeito de viver."
    },
    "tradition": {
      "type": "choice",
      "label": "Tradição",
      "options": [
        {
          "id": "ordem-de-hermes",
          "label": "Ordem de Hermes",
          "help": "Magos de fórmulas, rituais e hierarquia, organizados em Casas."
        },
        {
          "id": "coro-celestial",
          "label": "Coro Celestial",
          "help": "Magos da fé, que veem a magia como expressão do divino."
        },
        {
          "id": "culto-do-extase",
          "label": "Culto do Êxtase",
          "help": "Magos da experiência e dos sentidos, que buscam a magia no êxtase."
        },
        {
          "id": "eutanatos",
          "label": "Eutanatos",
          "help": "Magos da vida e da morte, ligados ao ciclo e ao destino."
        },
        {
          "id": "irmandade-akashica",
          "label": "Irmandade Akáshica",
          "help": "Magos da disciplina do corpo e da mente, das artes marciais e da meditação."
        },
        {
          "id": "sonhadores",
          "label": "Sonhadores (Kha'vadi)",
          "help": "Magos dos espíritos e dos sonhos, ligados a tradições xamânicas."
        },
        {
          "id": "verbena",
          "label": "Verbena",
          "help": "Magos da natureza, do sangue e da vida, herdeiros da bruxaria antiga."
        },
        {
          "id": "filhos-do-eter",
          "label": "Sociedade do Éter",
          "help": "Magos da ciência estranha, de invenções e teorias que a ciência comum rejeita."
        },
        {
          "id": "virtualidade",
          "label": "Adeptos da Virtualidade",
          "help": "Magos da informação e da tecnologia digital."
        },
        {
          "id": "orfao",
          "label": "Órfão",
          "help": "Mago sem Tradição. Não tem Esfera da Tradição sugerida."
        }
      ],
      "help": "O grupo de magos e a sua maneira de entender a magia. Sugere a Esfera de afinidade."
    },
