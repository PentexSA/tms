      "type": "list",
      "label": "Ressonância",
      "itemLabel": "Descritor",
      "item": { "value": { "type": "rating", "min": 0, "max": 5 } },
      "fixed": [
        { "id": "dynamic", "label": "Dinâmica" },
        { "id": "entropic", "label": "Entrópica" },
        { "id": "static", "label": "Estática" }
      ],
      "help": "Pontos e um descritor livre para cada tipo de Ressonância."
    },
    "wonders": {
      "type": "list",
      "label": "Maravilhas",
      "itemLabel": "Maravilha",
      "item": {
        "meta": [
          { "id": "level", "type": "number", "label": "Nível", "min": 1, "max": 10 },
          { "id": "arete", "type": "number", "label": "Arete", "min": 1, "max": 10 },
          { "id": "quintessence", "type": "number", "label": "Quintessência", "min": 0, "max": 100 }
        ],
        "notes": true
      },
      "help": "Arete e Quintessência só quando a Maravilha tem. Anote o efeito nas notas."
    },
    "familiar": { "type": "longText", "label": "Familiar", "maxLength": 600 },

    "merits": {
      "type": "list",
      "label": "Qualidades",
      "itemLabel": "Qualidade",
      "item": {
        "meta": [
          { "id": "kind", "type": "text", "label": "Tipo" },
          { "id": "cost", "type": "number", "label": "Custo", "min": 1, "max": 10 }
        ],
        "notes": true
      },
      "help": "Tipo (Físico, Social, Mental, Sobrenatural) e custo em pontos, como na ficha de papel. Anote o efeito nas notas."
    },
    "flaws": {
      "type": "list",
      "label": "Defeitos",
      "itemLabel": "Defeito",
      "item": {
        "meta": [
          { "id": "kind", "type": "text", "label": "Tipo" },
          { "id": "bonus", "type": "number", "label": "Bônus", "min": 1, "max": 10 }
        ],
        "notes": true
      },
      "help": "Tipo e bônus em pontos, como na ficha de papel. Anote o efeito nas notas."
    },
    "xpTotal": {
      "type": "number",
      "label": "Experiência total",
      "shortLabel": "Total",
      "min": 0,
      "max": 9999
    },
    "xpSpent": {
      "type": "number",
      "label": "Experiência gasta",
      "shortLabel": "Gasta",
      "min": 0,
      "max": 9999
    },
    "xpAvailable": {
      "type": "number",
      "label": "Experiência disponível",
      "shortLabel": "Disponível",
      "readOnly": true,
      "derive": "difference",
      "from": ["xpTotal", "xpSpent"]
    },

    "notes": { "type": "longText", "label": "Notas", "maxLength": 4000 },
    "storytellerNotes": {
      "type": "longText",
      "label": "Notas do Narrador",
      "maxLength": 4000
    }
