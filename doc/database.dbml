Project {
  database_type: "PostgreSQL"
}

Table users {
  id uuid [pk]
  email text [not null, unique]
  username text [not null, unique]
  hashed_password text [not null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table game_systems {
  id uuid [pk]
  code text [not null, unique]
  name text [not null]
  family text
  created_at timestamp
}

Table chronicles {
  id uuid [pk]
  storyteller_id uuid [not null, ref: > users.id]
  system_id uuid [not null, ref: > game_systems.id]
  name text [not null]
  character_approval boolean [not null, default: false, note: 'Aprovação de ficha nova (v4); desligada por padrão']
  creation_defaults jsonb [not null, default: '{}', note: 'Camada de configuração da criação (orçamentos, modo) copiada para a ficha nova']
  creation_settings_revision integer [not null, default: 0]
  created_at timestamp
  updated_at timestamp
}

Table characters {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  chronicle_id uuid [not null, ref: > chronicles.id]
  system_id uuid [not null, ref: > game_systems.id]
  name text [not null]
  sheet_data jsonb
  template_version text [not null]
  sheet_version integer [not null, default: 0]
  status text [not null, default: 'creating', note: 'creating | pending | active | archived | dead']
  locked_at timestamptz
  creation_completed_at timestamptz [note: 'Conclusão da conta (a submissão, quando vai para pending)']
  creation_completed_by uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  creation jsonb [not null, default: '{}', note: 'Escolhas (prioridades), camada de configuração da ficha e motivo da última devolução; só dono e narrador leem']
  creation_revision integer [not null, default: 0]
  approved_at timestamptz [note: 'Decisão do narrador que ativou a ficha']
  approved_by uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  activated_at timestamptz [note: 'Primeira ativação pela criação: só com ela a rota de estado volta para active']
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table trait_templates {
  id uuid [pk]
  system_id uuid [not null, ref: > game_systems.id]
  template_data jsonb
  version text [not null]
  published_at timestamptz [not null]
  indexes {
    (system_id, version) [unique]
  }
}

Table chronicle_members {
  chronicle_id uuid [not null, ref: > chronicles.id]
  user_id uuid [not null, ref: > users.id]
  joined_at timestamptz [not null]
  indexes {
    (chronicle_id, user_id) [pk]
  }
}

Table character_batches {
  id uuid [pk]
  character_id uuid [not null, ref: > characters.id, note: 'ON DELETE CASCADE']
  client_batch_id uuid [not null]
  created_by uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  by_role text [not null]
  sheet_version integer [not null]
  created_at timestamptz [not null]
  operation_id uuid [ref: > chronicle_operations.id, note: 'ON DELETE SET NULL']
  indexes {
    (character_id, client_batch_id) [unique]
  }
}

Table character_events {
  id uuid [pk]
  batch_id uuid [not null, ref: > character_batches.id, note: 'ON DELETE CASCADE']
  seq integer [not null]
  path text [not null]
  from_value jsonb
  to_value jsonb
  from_absent boolean [not null, default: false]
}

Table chronicle_audit {
  id uuid [pk]
  chronicle_id uuid [not null, ref: > chronicles.id, note: 'ON DELETE CASCADE']
  actor_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  action text [not null]
  target_character_id uuid [ref: > characters.id, note: 'ON DELETE SET NULL']
  target_user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  payload jsonb [not null, note: 'Mínimo necessário, sem conteúdo de notas']
  created_at timestamptz [not null]
}

Table character_commands {
  character_id uuid [not null, ref: > characters.id, note: 'ON DELETE CASCADE']
  client_command_id uuid [not null]
  kind text [not null, note: 'creation.complete | creation.approve | creation.return | creation.update']
  request_hash text [not null, note: 'sha256 do pedido: mesma chave com outro pedido dá 409']
  result jsonb [not null]
  created_by uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  created_at timestamptz [not null]
  indexes {
    (character_id, client_command_id) [pk]
  }
}

Table chronicle_operations {
  id uuid [pk]
  chronicle_id uuid [not null, ref: > chronicles.id, note: 'ON DELETE CASCADE']
  client_operation_id uuid [not null]
  kind text [not null, note: 'damage | heal | recovery (reservado) | revert']
  created_by uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  created_at timestamptz [not null]
  reverts_operation_id uuid [unique, ref: > chronicle_operations.id, note: 'ON DELETE SET NULL; nunca junto com reverts_batch_id']
  reverts_batch_id uuid [unique, ref: > character_batches.id, note: 'ON DELETE SET NULL']
  indexes {
    (chronicle_id, client_operation_id) [unique]
  }
}
