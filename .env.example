# Só o Postgres local de desenvolvimento (docker-compose.yml). Fora daqui, a
# URL vem do cofre de segredos (Azure Key Vault ou Google Secret Manager)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tms
API_PORT=3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Autenticação (Etapa 7). Em desenvolvimento, sem JWT_SECRET a API usa um
# segredo aleatório por processo (avisa no log) e as sessões caem quando ela
# reinicia. Para fixar um local, gere com `openssl rand -base64 48` e
# descomente; nunca copie um valor de outro lugar. Em produção é obrigatório
# e vem do Azure Key Vault ou do Google Secret Manager.
# JWT_SECRET=
JWT_ISSUER=tms-api
JWT_AUDIENCE=tms-app
# Origens do app web aceitas pelo CORS, separadas por vírgula (nunca "*")
CORS_ORIGINS=http://localhost:8081
# true só atrás de exatamente um proxy reverso que acrescenta o IP do cliente
# ao fim do X-Forwarded-For; sem proxy, false (o rate limit usa o IP da conexão)
TRUST_PROXY=false
