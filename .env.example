DATABASE_URL=postgres://{{DB_USER}}:{{DB_PASSWORD}}@localhost:{{DB_PORT}}/{{DB_NAME}}
API_PORT=3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Autenticação (Etapa 7). Em produção o JWT_SECRET é obrigatório e vem do
# Azure Key Vault ou do Google Secret Manager; gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=tms-api
JWT_AUDIENCE=tms-app
# Origens do app web aceitas pelo CORS, separadas por vírgula (nunca "*")
CORS_ORIGINS=http://localhost:8081
# true só atrás de um proxy reverso que acrescenta o X-Forwarded-For
TRUST_PROXY=false
