{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Os testes montam as fichas a partir de design/templates: mudar um
    // template invalida o cache dos testes.
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/design/templates/**"
      ]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/design/templates/**"
      ]
    }
  }
}
