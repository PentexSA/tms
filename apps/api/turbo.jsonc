{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Os testes publicam os templates de design/templates (e o banco de teste
    // migra com eles) e testam os scripts da raiz (scripts/): mudar um deles
    // invalida o cache dos testes.
    "test": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/design/templates/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/design/templates/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    }
  }
}
