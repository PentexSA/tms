{
  "name": "@tms/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/check-dev-env.mjs --dist config logger db sheet-core && bun --env-file=../../.env run --hot src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "start": "bun run dist/server.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "templates:publish": "node ../../scripts/check-dev-env.mjs --dist config logger db sheet-core && bun --env-file=../../.env src/scripts/publish-template.cli.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/eden": "catalog:",
    "@elysiajs/swagger": "1.3.1",
    "@sinclair/typebox": "0.34.52",
    "@tms/config": "workspace:*",
    "@tms/db": "workspace:*",
    "@tms/logger": "workspace:*",
    "@tms/sheet-core": "workspace:*",
    "dotenv": "16.6.1",
    "elysia": "catalog:",
    "file-type": "21.3.4",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@tms/bun-test-config": "workspace:*",
    "@tms/tsconfig": "workspace:*",
    "ajv": "8.20.0",
    "bun-types": "1.4.2",
    "typescript": "catalog:"
  }
}
