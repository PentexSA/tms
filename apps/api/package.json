{
  "name": "@tms/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "start": "bun run dist/index.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/eden": "catalog:",
    "@elysiajs/swagger": "1.3.1",
    "@sinclair/typebox": "0.34.52",
    "@tms/config": "workspace:*",
    "@tms/db": "workspace:*",
    "dotenv": "16.6.1",
    "elysia": "catalog:",
    "file-type": "21.3.4",
    "@tms/logger": "workspace:*",
    "serialize-error": "12.0.0"
  },
  "devDependencies": {
    "@tms/bun-test-config": "workspace:*",
    "@tms/tsconfig": "workspace:*",
    "bun-types": "1.4.2",
    "typescript": "catalog:"
  }
}
